    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap');
        
        :root {
            --dar: #050507;
            --mid: #12121f;
            --acc: #7928ca;
            --sec: #ff0080;
            --neon: #00fff2;
            --gold: #ffd000;
            --wa: #25d366;
            --tg: #0088cc;
        }
        
        body {
            font-family: 'Rajdhani', sans-serif;
            background: var(--dar);
            color: #fff;
            overflow-x: hidden;
        }
        
        .font-hanz {
            font-family: 'Orbitron', sans-serif;
        }
        
        /* Background Animasi */
        .bg-animated {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: -2;
            background: 
                radial-gradient(circle at 20% 50%, rgba(121,40,202,0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255,0,128,0.12) 0%, transparent 50%),
                radial-gradient(circle at 40% 20%, rgba(0,255,242,0.08) 0%, transparent 50%),
                linear-gradient(180deg, #050507 0%, #0f0f1a 50%, #050507 100%);
        }
        
        .partikel {
            position: fixed;
            width: 100%; height: 100%;
            z-index: -1;
            pointer-events: none;
        }
        
        .partikel span {
            position: absolute;
            width: 2px; height: 2px;
            background: rgba(0,255,242,0.6);
            border-radius: 50%;
            box-shadow: 0 0 6px rgba(0,255,242,0.8);
            animation: naik 12s linear infinite;
        }
        
        @keyframes naik {
            0% { transform: translateY(100vh); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-10vh); opacity: 0; }
        }
        
        .glow-text {
            text-shadow: 
                0 0 5px var(--neon),
                0 0 15px var(--neon),
                0 0 30px var(--acc),
                0 0 50px var(--acc);
        }
        
        .glow-pink {
            text-shadow: 
                0 0 5px var(--sec),
                0 0 15px var(--sec),
                0 0 30px var(--sec);
        }

        .glow-wa {
            text-shadow: 0 0 5px var(--wa), 0 0 15px var(--wa);
        }

        .glow-tg {
            text-shadow: 0 0 5px var(--tg), 0 0 15px var(--tg);
        }
        
        .card-sangar {
            background: linear-gradient(135deg, rgba(18,18,31,0.8) 0%, rgba(5,5,7,0.9) 100%);
            border: 1px solid rgba(121,40,202,0.3);
            border-radius: 16px;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }
        
        .card-sangar::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,0,128,0.1), transparent);
            transition: left 0.5s ease;
        }
        
        .card-sangar:hover {
            transform: translateY(-6px) scale(1.02);
            border-color: var(--sec);
            box-shadow: 
                0 0 20px rgba(121,40,202,0.4),
                0 10px 40px rgba(0,0,0,0.6);
        }
        
        .card-sangar:hover::before {
            left: 100%;
        }
        
        .btn-hanz {
            background: linear-gradient(90deg, var(--acc), var(--sec));
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 700;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .btn-hanz:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px var(--acc), 0 0 40px var(--sec);
        }

        .btn-wa {
            background: linear-gradient(90deg, #1fb74f, #25d366);
        }
        .btn-wa:hover {
            box-shadow: 0 0 25px var(--wa), 0 0 40px var(--wa);
        }

        .btn-tg {
            background: linear-gradient(90deg, #0077b5, #0088cc);
        }
        .btn-tg:hover {
            box-shadow: 0 0 25px var(--tg), 0 0 40px var(--tg);
        }
        
        .garis-neon {
            height: 3px;
            background: linear-gradient(90deg, var(--neon), var(--acc), var(--sec), transparent);
            border-radius: 2px;
        }
        
        .harga {
            background: linear-gradient(90deg, var(--gold), #ff9500);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 900;
        }
        
        .nav-link {
            position: relative;
        }
        
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px; left: 0;
            width: 0; height: 2px;
            background: var(--neon);
            transition: width 0.3s ease;
        }
        
        .nav-link:hover::after {
            width: 100%;
        }
        
        .logo-glow {
            filter: drop-shadow(0 0 8px var(--neon)) drop-shadow(0 0 16px var(--acc));
        }

        a.konta-link {
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }
        a.konta-link:hover {
            transform: translateX(8px);
        }
    </style>
