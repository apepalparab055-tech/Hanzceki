    <!-- Script -->
    <script>
        // Partikel bergerak
        const partikelContainer = document.getElementById('partikel');
        const jumlahPartikel = 60;

        for (let i = 0; i < jumlahPartikel; i++) {
            const p = document.createElement('span');
            p.style.left = Math.random() * 100 + '%';
            p.style.animationDelay = Math.random() * 12 + 's';
            p.style.animationDuration = (8 + Math.random() * 10) + 's';
            partikelContainer.appendChild(p);
        }

        // Menu HP
        const menuBtn = document.getElementById('menuBtn');
        const menuHp = document.getElementById('menuHp');
        menuBtn.addEventListener('click', () => {
            menuHp.classList.toggle('hidden');
        });

        // Animasi gulir halus
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    menuHp.classList.add('hidden');
                }
            });
        });
